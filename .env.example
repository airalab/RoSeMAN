# Настройки Docker Compose. Для внешнего окружения замените пароль MongoDB.
COMPOSE_PROJECT_NAME=roseman
ROSEMAN_IMAGE=roseman:local
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secret
MONGO_DATABASE=roseman
MONGO_PORT=27017
REST_PORT=3000

API_ENABLED=true
PORT=3000

# Для прямого npm-запуска используется localhost. При изменении учётных данных
# MongoDB синхронно обновите этот URI. В Docker Compose значение автоматически
# заменяется адресом сервиса mongodb и настройками выше.
MONGODB_URI=mongodb://admin:secret@localhost:27017/roseman?authSource=admin

# Для локальной новой базы создаём индексы автоматически. В production лучше
# установить false и выполнять `npm run sync-indexes` отдельно.
MONGODB_AUTO_INDEX=true
MAX_PERIOD_DAYS=31

# DEPRECATED: whitelist применяется только к legacy datalog handler.
#ROBONOMICS_ACCOUNTS=

INDEXER_ENABLED=false
MEASUREMENT_ENABLED=false
GEOCODING_ENABLED=false

# Фильтрация хендлеров индексатора (опционально).
# Актуальный handler: cps-payload-set.
# DEPRECATED legacy handlers: datalog-new-record, rws-new-devices, rws-extrinsic, rws-story.
# ENABLED_HANDLERS — allowlist (через запятую). Если задан — включаются только перечисленные.
# DISABLED_HANDLERS — denylist. Применяется поверх allowlist.
# Если обе переменные пустые — включены все, включая legacy handlers.
# Для новых развёртываний используйте явный CPS-only allowlist.
#ENABLED_HANDLERS=cps-payload-set
#DISABLED_HANDLERS=

# Максимальный размер ответа IPFS gateway в байтах (по умолчанию 10 МиБ).
IPFS_MAX_RESPONSE_BYTES=10485760

# Базовый REST-профиль не запускает indexer/measurement, поэтому CPS здесь
# выключен. Оверлей `.env.polkadot` включает CPS и каноническое/raw-хранилища.
CPS_ENABLED=false
#CPS_CANONICAL_STORAGE_ENABLED=false
#CPS_RAW_PAYLOAD_STORAGE_ENABLED=false
# Числовые корневые NodeId для snapshot и realtime-поддеревьев.
# Snapshot рекурсивно читает payload корней и всех их потомков.
# Пустое значение: snapshot не читает узлы, realtime принимает любой NodeId.
#CPS_NODE_IDS=0
# Fallback для старых IPFS anchors без сохранённого meta: raw, xz, zstd, lz4 или zlib.
# Для новых anchors формат читается из cps.meta; пустое meta нового layout означает zstd.
CPS_BATCH_WIRE_FORMAT=xz
#CPS_POLL_INTERVAL=10000
#CPS_LEASE_DURATION=60000
#CPS_MAX_ANCHORS_PER_POLL=10
#CPS_MAX_ATTEMPTS=5
#CPS_RETRY_BASE_DELAY=15000
#CPS_MAX_COMPRESSED_BYTES=10485760
#CPS_MAX_DECOMPRESSED_BYTES=10485760
#CPS_MAX_XZ_MEMORY_BYTES=67108864
#CPS_MAX_ENVELOPE_COUNT=10000
#CPS_SENSOR_SS58_PREFIX=32

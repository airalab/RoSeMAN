# Docker Compose загружает этот файл после общего `.env`, поэтому значения ниже
# переопределяют режим процесса, но используют общие MongoDB/CPS-настройки.
API_ENABLED=false

ROBONOMICS_WS=wss://polkadot.rpc.robonomics.network
ROBONOMICS_STATE_KEY=polkadot_robonomics
ROBONOMICS_START_BLOCK=latest # Используется только при первом запуске. Номер блока или `latest` (текущий блок чейна). По умолчанию `latest`
ROBONOMICS_START_BLOCK_FORCE=false # Принудительно начать с ROBONOMICS_START_BLOCK, игнорируя сохранённый в БД блок. По умолчанию false. Не забудьте выключить после запуска

INDEXER_ENABLED=true
# Datalog выключен allowlist-ом; включены CPS и необходимые RWS-хендлеры.
ENABLED_HANDLERS=cps-payload-set,rws-extrinsic,rws-story

MEASUREMENT_ENABLED=true
# Максимальный размер ответа IPFS gateway в байтах (по умолчанию 10 МиБ).
IPFS_FETCH_TIMEOUT=30000
IPFS_MAX_RESPONSE_BYTES=10485760
GEOCODING_ENABLED=false

CPS_ENABLED=true
CPS_CANONICAL_STORAGE_ENABLED=true
CPS_RAW_PAYLOAD_STORAGE_ENABLED=true
CPS_NODE_IDS=0
CPS_BATCH_WIRE_FORMAT=xz
CPS_POLL_INTERVAL=1000
CPS_LEASE_DURATION=60000
CPS_MAX_ANCHORS_PER_POLL=10
CPS_MAX_ATTEMPTS=5
CPS_RETRY_BASE_DELAY=5000
CPS_OWNER_SS58_PREFIX=32
